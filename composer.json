{
    "name": "dotkernel/dot-annotated-services",
    "type": "library",
    "description": "Dotkernel service creation component through laminas-servicemanager and annotations",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-annotated-services",
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "keywords": [
        "annotations",
        "services",
        "factories",
        "container",
        "laminas",
        "mezzio",
        "service-manager"
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "doctrine/annotations": "^1.14.3",
        "doctrine/orm" : "^2.20",
        "laminas/laminas-servicemanager": "^3.22.1",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/container": "^1.1 || ^2.0"
    },
    "suggest": {
        "symfony/cache": "A PSR-6 pool to cache parsed annotations"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dot\\AnnotatedServices\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\AnnotatedServices\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "phpstan analyse --memory-limit 1G",
        "test": "phpunit --colors=always"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
